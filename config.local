# sudo /opt/homebrew/opt/openvpn/sbin/openvpn --config ./eu-central-1-Mushishy-premium.ovpn

#Host *
#    Protocol 2
#    StrictHostKeyChecking accept-new
#    Compression yes
#    ServerAliveInterval 60
#    ExitOnForwardFailure yes    

#Host *
#   Protocol 2
#   VerifyHostKeyDNS yes
#   StrictHostKeyChecking yes
#   ForwardAgent no
#   ClearAllForwardings yes
#   ExitOnForwardFailure yes 

Host pkali
    HostName 10.1.20.10
    User kali

Host astor
    HostName 192.168.1.126
    User kono
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/astor
    #SendEnv -LC_*

Host ava
    #Hostname 100.103.134.82
    HostName 192.168.1.123
    User kono
    PreferredAuthentications publickey
    IdentityFile ~/.ssh/ava
    SendEnv -LC_*

#Host bee
#   Hostname 192.168.1.88
#   User synologysupport_xIFTWwPLYb1OF2M
#   Port 54105
#   PreferredAuthentications publickey
#   IdentityFile ~/.ssh/bee

Host iris
   HostName 100.78.112.46
   User kono
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/iris

Host twobe
   HostName 192.168.1.115
   #Hostname 100.86.58.87
   User xslizik
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/twobe

Host bos
   #Hostname bos-2025.ipsec.info
   HostName 194.1.130.55
   User xslizik
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/bos

Host bos-xslizik
   HostName bos-xslizik.local
   User user
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/bos-xslizik
   ProxyJump bos

Host macedo
   #HostName 147.175.154.32
   HostName 147.175.146.227
   Port 54322
   #User slizik
   User xslizik
   PreferredAuthentications publickey
   IdentityFile ~/.ssh/macedo
   LocalForward 8080 localhost:8080
   LocalForward 8081 localhost:8081
   LocalForward 8006 localhost:8006

Host lkali
    HostName 10.211.55.27
    IdentityFile ~/.ssh/parallels-kali
    User parallels
#    ForwardX11 yes
#    ForwardX11Trusted yes 	

Host gitlab.kypo.fiit.stuba.sk
    HostName gitlab.kypo.fiit.stuba.sk
    IdentityFile ~/.ssh/kypo

Host gitlab.tryhackme.loc
    HostName gitlab.tryhackme.loc
    IdentityFile ~/.ssh/thm
    IdentitiesOnly yes

Host student.fiit.stuba.sk
    HostName student.fiit.stuba.sk
    User slizik20
    #IdentityFile ~/.ssh/slizik20
    HostKeyAlgorithms +ssh-dss
    KexAlgorithms +diffie-hellman-group1-sha1
    Ciphers aes128-cbc

Host team10-24.studenti.fiit.stuba.sk
    HostName team10-24.studenti.fiit.stuba.sk
    User ubuntu
    IdentityFile ~/.ssh/team10-24-key.private
    ProxyJump student.fiit.stuba.sk

Host fei
    HostName feictf.xyz
    User hacker
    IdentityFile ~/.ssh/fei
    DynamicForward 8080

Host ludus
    #HostName 100.112.114.50
    HostName 100.93.9.9
    #HostName 192.168.250.2
    User slizik
    IdentityFile ~/.ssh/ludus
    LocalForward 8080 localhost:8080
    LocalForward 8081 localhost:8081
    LocalForward 8006 localhost:8006

Host artemis
    #Hostname 192.168.250.50
    HostName 100.108.217.13
    User xslizik
    IdentityFile ~/.ssh/artemis
    LocalForward 5000 localhost:5000
    LocalForward 8080 localhost:8080
    LocalForward 8081 localhost:8081
    LocalForward 8006 localhost:8006

Host dulus
    HostName 10.2.60.2
    User xslizik
    Port 22
    IdentityFile ~/.ssh/fiit
    LocalForward 8080 localhost:8080
    LocalForward 8081 localhost:8081
    LocalForward 8006 localhost:8006

Host erik
    HostName 198.51.100.1
    User john
    Port 22
    IdentityFile ~/.ssh/erik_ludus_server
    LocalForward 8080 localhost:8080
    LocalForward 8081 localhost:8081
    LocalForward 8006 localhost:8006
    

## wireguard for ludus raven
