# Endpoint = 100.93.9.9:51820

# #scp -r ludus:/home/slizik/ela .

## to access a device with password use
# ssh -o PreferredAuthentications=password -o PubkeyAuthentication=no kono@192.168.1.94

## to clone repositories with ssh it is best to set up a host like this gitlab.kypo.fiit.stuba.sk and add an identity file
## for kypo you have to have running openvpn as well
# sudo openvpn --config ~/.ssh/stuba-client.ovpn
# git clone git@gitlab.kypo.fiit.stuba.sk:muni-kypo-trainings/games/debian-12-generic-test.git

## make sure to do chmod 700 ~/.ssh/*
# Host *.demo-cert.sk
# proxy jumping
#  ProxyJump gw.demo-cert.sk
#  ProxyJump none # -> on gw.demo-cert.sk

## x11 forwarding
#  ForwardX11 yes
#  ForwardX11Trusted yes

## portforwarding
#  DynamicForward 8080 # -> socks proxy route traffic through local port 8080
#  LocalForward 1337 127.0.0.1:80 # -> local port 1337 is forwarded to the machines port 80
