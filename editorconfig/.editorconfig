# ~/.editorconfig - minimal, portable rules for Go, Kubernetes/YAML manifests,
# shell scripting, and general Linux admin work. Plain key/value pairs only,
# no plugins required - see https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = space
indent_size = 4

[{go.mod,go.sum}]
indent_style = space
indent_size = 4

# Kubernetes manifests, Helm templates, GitHub Actions, Ansible playbooks
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.tpl]
indent_style = space
indent_size = 2

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2

[{.bashrc,.zshrc,.zprofile,.bash_profile,.profile}]
indent_style = space
indent_size = 2

[*.{json,toml}]
indent_style = space
indent_size = 2

[*.{tf,tfvars}]
indent_style = space
indent_size = 2

[Dockerfile*]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false